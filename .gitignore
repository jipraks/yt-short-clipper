# ---- Dependencies ----
node_modules/

# ---- Frontend build output ----
dist/
*.tsbuildinfo

# ---- App output / user data (generated clips, sessions) ----
out/

# ---- Tauri / Rust build ----
src-tauri/target/
src-tauri/gen/

# ---- Bundled / downloaded binaries ----
# Regenerated by `npm run deps` (ffmpeg, deno, models) and
# `npm run build:sidecar` (ytclip-sidecar-*.exe). Large & machine-specific.
src-tauri/binaries/

# ---- Build staging & artifacts (keep the PyInstaller spec files) ----
build/*
!build/spec/

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# ---- Secrets / local config ----
.env
.env.*
!.env.example
# YouTube auth cookies — never commit
cookies.txt

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Legacy v1 (kept out of repo; lives at github.com/jipraks/yt-short-clipper) ----
yt-short-clipper-v1/
